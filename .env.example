# Names only. Copy to .env and fill in locally; never commit real values.
# Every model key below is optional: the default chain is keyless (ADR 0003).

# App runtime Postgres URL: the non-owner login role without BYPASSRLS, so RLS applies (Neon pooled URL in production).
DATABASE_URL=
# Migrations only: direct, unpooled URL for the schema owner role; never used by the running app.
DATABASE_URL_UNPOOLED=
# Random 32+ byte secret used to sign session cookies (e.g. `openssl rand -base64 32`).
DELEGATE_SESSION_SECRET=
# Dev only (ignored when NODE_ENV=production): 1 replays a scripted, clearly labelled simulated run instead of the real runtime.
DELEGATE_FAKE_RUNNER=
# Dev only (ignored when NODE_ENV=production): 1 runs web missions with the owner audience, so evaluation-only providers (NVIDIA) can serve them.
DELEGATE_OWNER_MODE=
# Wall-clock limit of one server invocation in ms (ADR 0007 amendment). Runs hand off to a new invocation shortly before it. Defaults to 300000 on Vercel (VERCEL=1) and to no limit elsewhere.
DELEGATE_FUNCTION_MAX_MS=

# Optional: NVIDIA API catalog key (Nemotron 3 Ultra, Mistral Large 4, Nemotron 3.5 Lightning, Kimi K3.1 Pro offline).
# Trial terms are evaluation-only: used for owner runs (DELEGATE_OWNER_MODE, evals, recordings), never for the public demo.
# Keep it in .env.local (gitignored); `pnpm --filter @delegate/runtime live:nvidia` re-measures the catalog.
NVIDIA_API_KEY=
# Optional: Groq free-tier key (gpt-oss-120b, qwen).
GROQ_API_KEY=
# Optional: Cerebras free-tier key (fast qwen / gpt-oss).
CEREBRAS_API_KEY=
# Optional: OpenRouter key for its :free models.
OPENROUTER_API_KEY=
# Optional: Cloudflare account id for Workers AI (used with the token below).
CLOUDFLARE_ACCOUNT_ID=
# Optional: Cloudflare API token with Workers AI read access.
CLOUDFLARE_API_TOKEN=
# Optional: bring-your-own-key Claude; never required.
ANTHROPIC_API_KEY=

# Optional: OTLP/HTTP endpoint for traces (e.g. a local collector); unset disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Ship-a-PR (M5, ADR 0011). Off unless DELEGATE_SHIP_A_PR=1, so no sandbox quota is spent by default.
DELEGATE_SHIP_A_PR=
# Sandbox for the Engineer: vercel (Vercel Sandbox microVM, free on Hobby; default when NODE_ENV=production) or local (dev/tests only: temp dir + scrubbed env, refuses to run in production; default otherwise).
DELEGATE_SANDBOX=
# Vercel Sandbox auth is automatic on Vercel (OIDC). Locally: `vercel env pull` writes this short-lived token; never commit it.
VERCEL_OIDC_TOKEN=
# GitHub App used to open pull requests (Contents + Pull requests read & write, Metadata read, no webhook), installed only on chosen repos. See docs/DEPLOY.md.
GITHUB_APP_ID=
# The App's private key (PEM). Literal \n escapes are accepted so it fits on one line; never logged, never passed to the sandbox.
GITHUB_APP_PRIVATE_KEY=
# The App's URL slug (github.com/apps/<slug>), used for the install link and Connect GitHub.
GITHUB_APP_SLUG=

# Platform connections (ADR 0014). All optional; each feature stays off without its variables.
# 32-byte key for AES-256-GCM encryption of MCP connector secrets: `openssl rand -hex 32`.
# Without it, connectors that need a secret cannot be added (secret-less connectors still work).
DELEGATE_ENCRYPTION_KEY=
# GitHub App user authorization ("Connect GitHub"). Callback URL: https://<host>/api/github/callback,
# Setup URL: https://<host>/api/github/setup (enable "Redirect on update").
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
