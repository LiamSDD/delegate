{
  "name": "@delegate/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Delegate command-line interface.",
  "type": "module",
  "bin": {
    "delegate": "./bin/delegate.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "delegate": "node bin/delegate.mjs"
  },
  "dependencies": {
    "@delegate/sdk": "workspace:*",
    "tsx": "4.23.15",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
