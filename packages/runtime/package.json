{
  "name": "@delegate/runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Delegate agent runtime: loop, planner, orchestrator, critic, model router.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./telemetry": {
      "types": "./src/telemetry.ts",
      "default": "./src/telemetry.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./security": {
      "types": "./src/security.ts",
      "default": "./src/security.ts"
    },
    "./testing": {
      "types": "./src/testing/fakes.ts",
      "default": "./src/testing/fakes.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "vitest run --config vitest.live.config.ts src/live/smoke.live.test.ts",
    "live:xray": "vitest run --config vitest.live.config.ts src/live/company-xray.live.test.ts",
    "live:nvidia": "vitest run --config vitest.live.config.ts src/live/nvidia-discovery.live.test.ts",
    "live:audit": "vitest run --config vitest.live.config.ts src/live/automation-audit.live.test.ts",
    "live:build-agent": "vitest run --config vitest.live.config.ts src/live/build-agent.live.test.ts",
    "crawl-bench": "tsx src/crawl/bench-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@delegate/policy": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-trace": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@vercel/sandbox": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
