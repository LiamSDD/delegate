{
  "name": "@delegate/evals",
  "version": "0.0.0",
  "private": true,
  "description": "Delegate eval harness, datasets, graders and red-team suite.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./results": {
      "types": "./src/results.ts",
      "default": "./src/results.ts"
    },
    "./evolution": {
      "types": "./src/evolve/log.ts",
      "default": "./src/evolve/log.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "tsx src/run-eval.ts",
    "gate": "tsx src/gate.ts",
    "agreement": "tsx src/agreement.ts",
    "redteam": "tsx src/redteam/cli.ts",
    "redteam:schema": "tsx src/redteam/write-schema.ts",
    "evolve": "tsx src/evolve/cli.ts"
  },
  "dependencies": {
    "@delegate/policy": "workspace:*",
    "@delegate/runtime": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
