{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "mission": {
      "type": "string",
      "const": "xray"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "input": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "focus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": ["url"],
      "additionalProperties": false
    },
    "company": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "industry": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "size": {
          "type": "string",
          "enum": ["small", "medium", "large"]
        }
      },
      "required": ["name", "country", "industry", "size"],
      "additionalProperties": false
    },
    "expectedFacts": {
      "minItems": 2,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "proposition": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
          },
          "justification": {
            "type": "string",
            "minLength": 5,
            "maxLength": 400
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": ["id", "proposition", "justification", "sourceUrl", "verifiedAt"],
        "additionalProperties": false
      }
    },
    "difficulty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "schema_valid"
              }
            },
            "required": ["kind"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "min_citations"
              },
              "min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["kind", "min"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "no_dead_links"
              }
            },
            "required": ["kind"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "max_cost_micro_usd"
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["kind", "max"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "max_latency_ms"
              },
              "max": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["kind", "max"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "mentions"
              },
              "terms": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["kind", "terms"],
            "additionalProperties": false
          }
        ]
      }
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "mission",
    "version",
    "input",
    "company",
    "expectedFacts",
    "difficulty",
    "checks",
    "rubric",
    "tags"
  ],
  "additionalProperties": false
}
