{
  "version": 1,
  "providers": [
    {
      "id": "pollinations",
      "kind": "openai-compatible",
      "baseUrl": "https://text.pollinations.ai",
      "chatPath": "/openai",
      "keyless": true,
      "terms": "public-demo-ok",
      "maxClassification": "public",
      "dataPolicy": "Community-run anonymous tier; retention and training terms not yet verified. Treat as public: never send confidential data.",
      "limits": {
        "requestsPerMinute": 1.5,
        "maxConcurrent": 1
      },
      "notes": "Classic OpenAI-compatible text endpoint. Probed 2026-11-24: model \"openai\" serves gpt-oss-20b with tool calling, streaming and usage incl. cached tokens; streamed reasoning arrives in delta.reasoning. \"openai-fast\" returns 402 and is not used. Concurrent anonymous requests were answered with 429 (no retry-after) on 2026-11-24, so calls are serialised. Completions stop at 1500 tokens including reasoning (observed), and calls after the first in a run were answered about 40 s apart, so the router spaces requests at 1.5 per minute."
    },
    {
      "id": "webllm",
      "kind": "webllm",
      "keyless": true,
      "terms": "local-only",
      "maxClassification": "confidential",
      "dataPolicy": "Runs on the visitor's GPU via WebGPU; prompts never leave the browser.",
      "unverified": true,
      "notes": "Private mode. Requires WebGPU (Chrome/Edge). Function-calling model list to be confirmed in M1."
    },
    {
      "id": "ollama",
      "kind": "ollama",
      "baseUrl": "http://localhost:11434/v1",
      "keyless": true,
      "terms": "local-only",
      "maxClassification": "restricted",
      "dataPolicy": "Local inference on the operator's machine; nothing leaves the host.",
      "notes": "Opt-in only (self-hosting, owner evals, demo recordings). Uses Ollama's OpenAI-compatible endpoint."
    },
    {
      "id": "nvidia",
      "kind": "openai-compatible",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "apiKeyEnv": "NVIDIA_API_KEY",
      "keyless": false,
      "terms": "public-demo-ok",
      "maxClassification": "public",
      "dataPolicy": "NVIDIA API catalog trial terms (development and evaluation, not production). Owner decision 2026-11-25 (ADR 0003 Amendment 3): also serves the public demo, public data only, with this trial-terms caveat; about 40 RPM per key shared by every visitor.",
      "limits": {
        "modelRequestsPerMinute": 35,
        "scope": "process"
      },
      "notes": "About 40 RPM per key (unofficial). Probed 2026-11-24 with a streaming tool-calling request (pnpm --filter @delegate/runtime live:nvidia): nemotron-3-ultra-550b-a55b and mistral-large-4-1t-a52b answer with a correct tool call in 1-4 s; nemotron-3.5-lightning-30b-a3b in under 0.5 s; kimi-k3.1-pro gave no first token within 75 s (3-4 min observed), so it is interactive: false and used only by offline runs. kimi-k3, deepseek-v4-pro and glm-5.3 return 410 and were removed. Used only when NVIDIA_API_KEY is set; evaluation-only terms keep it out of the public demo. Probed 2026-11-24 with the quarantine-reader prompt: Nemotron models reason by default and ignore reasoning_effort and /no_think; nemotron-3.5-lightning spent its whole 6,000-token budget reasoning on 3 KB pages, so every reader call failed. chat_template_kwargs.enable_thinking=false (quirk disable-thinking) gives valid JSON in about 1.5 s (Lightning) and 3.7 s (Ultra, down from 12 s). Mistral Large 4 also reasons (about 27 s for the same call) and has no switch configured. Bake-off 2026-11-25 (pnpm --filter @delegate/runtime exec vitest run --config vitest.live.config.ts src/live/nvidia-bakeoff.live.test.ts; 4 Delegate-shaped tasks x 2): minimax-m3.1-flash 1.000, step-5-preview 0.988, kimi-k3.1-pro 0.975 (first token 100-153 s), mistral-large-4 0.750, nemotron-3.5-super-vl 0.725, nemotron-3-ultra 0.675. Roles use this ranking; the router keeps one token bucket per model (35 RPM), shared per process, and drops to the next model when a bucket is empty, a 429/5xx/timeout occurs, then returns as soon as the higher model is available again."
    },
    {
      "id": "groq",
      "kind": "openai-compatible",
      "baseUrl": "https://api.groq.com/openai/v1",
      "apiKeyEnv": "GROQ_API_KEY",
      "keyless": false,
      "terms": "public-demo-ok",
      "maxClassification": "internal",
      "dataPolicy": "Zero data retention can be enabled in the Groq console.",
      "limits": {
        "requestsPerMinute": 30,
        "tokensPerMinute": 8000
      }
    },
    {
      "id": "cerebras",
      "kind": "openai-compatible",
      "baseUrl": "https://api.cerebras.ai/v1",
      "apiKeyEnv": "CEREBRAS_API_KEY",
      "keyless": false,
      "terms": "public-demo-ok",
      "maxClassification": "internal",
      "dataPolicy": "No training on customer data, per Cerebras documentation.",
      "limits": {
        "requestsPerMinute": 30
      },
      "unverified": true,
      "notes": "Per-model limits differ (qwen up to 300 RPM); 30 RPM is a conservative provider-wide bucket."
    },
    {
      "id": "openrouter",
      "kind": "openai-compatible",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "keyless": false,
      "terms": "public-demo-ok",
      "maxClassification": "public",
      "dataPolicy": "Data policy depends on the upstream provider serving the :free model.",
      "limits": {
        "requestsPerMinute": 20
      }
    },
    {
      "id": "cloudflare",
      "kind": "openai-compatible",
      "baseUrl": "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1",
      "apiKeyEnv": "CLOUDFLARE_API_TOKEN",
      "requiredEnv": ["CLOUDFLARE_ACCOUNT_ID"],
      "keyless": false,
      "terms": "public-demo-ok",
      "maxClassification": "internal",
      "dataPolicy": "Cloudflare states no training on customer data in Workers AI.",
      "notes": "Free allowance is 10,000 neurons per day rather than a request rate."
    },
    {
      "id": "anthropic",
      "kind": "anthropic",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "keyless": false,
      "terms": "byok",
      "maxClassification": "confidential",
      "dataPolicy": "Bring your own key; Anthropic commercial terms of the key owner apply.",
      "pricing": {
        "claude-opus-5-5": {
          "inputUsdPerMTok": 4,
          "outputUsdPerMTok": 20,
          "cacheReadUsdPerMTok": 0.2,
          "cacheWriteUsdPerMTok": 5
        },
        "claude-sonnet-5-5": {
          "inputUsdPerMTok": 2,
          "outputUsdPerMTok": 10,
          "cacheReadUsdPerMTok": 0.1,
          "cacheWriteUsdPerMTok": 2.5
        },
        "claude-haiku-5-5": {
          "inputUsdPerMTok": 0.1,
          "outputUsdPerMTok": 0.5,
          "cacheReadUsdPerMTok": 0.01,
          "cacheWriteUsdPerMTok": 0.125
        }
      },
      "notes": "Opus 5.5 and Sonnet 5.5 reject forced tool_choice; Opus 5.5 thinking cannot be disabled (use effort)."
    }
  ],
