{
  "version": 1,
  "providers": [
    {
      "id": "pollinations",
      "kind": "openai-compatible",
      "baseUrl": "https://text.pollinations.ai",
      "chatPath": "/openai",
      "keyless": true,
      "terms": "public-demo-ok",
      "maxClassification": "public",
      "dataPolicy": "Community-run anonymous tier; retention and training terms not yet verified. Treat as public: never send confidential data.",
      "limits": { "requestsPerMinute": 4 },
      "unverified": true,
      "notes": "Classic OpenAI-compatible text endpoint. Base URL, path, model aliases, tool calling and anonymous limits to be confirmed by pnpm smoke in M1."
    },
    {
      "id": "llm7",
      "kind": "openai-compatible",
      "baseUrl": "https://api.llm7.io/v1",
      "keyless": true,
      "terms": "public-demo-ok",
      "maxClassification": "public",
      "dataPolicy": "Community-run anonymous access; retention and training terms not yet verified. Treat as public: never send confidential data.",
      "limits": { "requestsPerMinute": 20 },
      "unverified": true,
      "notes": "Anonymous access without a token. Model IDs and limits to be confirmed by pnpm smoke in M1."
    },
    {
      "id": "webllm",
      "kind": "webllm",
      "keyless": true,
      "terms": "local-only",
      "maxClassification": "confidential",
      "dataPolicy": "Runs on the visitor's GPU via WebGPU; prompts never leave the browser.",
      "unverified": true,
      "notes": "Private mode. Requires WebGPU (Chrome/Edge). Function-calling model list to be confirmed in M1."
    },
    {
      "id": "ollama",
      "kind": "ollama",
      "baseUrl": "http://localhost:11434/v1",
      "keyless": true,
      "terms": "local-only",
      "maxClassification": "restricted",
      "dataPolicy": "Local inference on the operator's machine; nothing leaves the host.",
      "notes": "Opt-in only (self-hosting, owner evals, demo recordings). Uses Ollama's OpenAI-compatible endpoint."
    },
    {
      "id": "nvidia",
      "kind": "openai-compatible",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "apiKeyEnv": "NVIDIA_API_KEY",
      "keyless": false,
      "terms": "evaluation-only",
      "maxClassification": "public",
      "dataPolicy": "NVIDIA API catalog trial terms: development and evaluation, not production. Owner evals and recordings only.",
      "limits": { "requestsPerMinute": 40 },
      "unverified": true,
      "notes": "About 40 RPM per key (unofficial)."
    },
    {
      "id": "groq",
      "kind": "openai-compatible",
      "baseUrl": "https://api.groq.com/openai/v1",
      "apiKeyEnv": "GROQ_API_KEY",
      "keyless": false,
      "terms": "public-demo-ok",
      "maxClassification": "internal",
      "dataPolicy": "Zero data retention can be enabled in the Groq console.",
      "limits": { "requestsPerMinute": 30, "tokensPerMinute": 8000 }
    },
    {
      "id": "cerebras",
      "kind": "openai-compatible",
      "baseUrl": "https://api.cerebras.ai/v1",
      "apiKeyEnv": "CEREBRAS_API_KEY",
      "keyless": false,
      "terms": "public-demo-ok",
      "maxClassification": "internal",
      "dataPolicy": "No training on customer data, per Cerebras documentation.",
      "limits": { "requestsPerMinute": 30 },
      "unverified": true,
      "notes": "Per-model limits differ (qwen up to 300 RPM); 30 RPM is a conservative provider-wide bucket."
    },
    {
      "id": "openrouter",
      "kind": "openai-compatible",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "keyless": false,
      "terms": "public-demo-ok",
      "maxClassification": "public",
      "dataPolicy": "Data policy depends on the upstream provider serving the :free model.",
      "limits": { "requestsPerMinute": 20 }
    },
    {
      "id": "cloudflare",
      "kind": "openai-compatible",
      "baseUrl": "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1",
      "apiKeyEnv": "CLOUDFLARE_API_TOKEN",
      "requiredEnv": ["CLOUDFLARE_ACCOUNT_ID"],
      "keyless": false,
      "terms": "public-demo-ok",
      "maxClassification": "internal",
      "dataPolicy": "Cloudflare states no training on customer data in Workers AI.",
      "notes": "Free allowance is 10,000 neurons per day rather than a request rate."
    },
    {
      "id": "anthropic",
      "kind": "anthropic",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "keyless": false,
      "terms": "byok",
      "maxClassification": "confidential",
      "dataPolicy": "Bring your own key; Anthropic commercial terms of the key owner apply.",
      "pricing": {
        "claude-opus-5-5": {
          "inputUsdPerMTok": 4,
          "outputUsdPerMTok": 20,
          "cacheReadUsdPerMTok": 0.2,
          "cacheWriteUsdPerMTok": 5
        },
        "claude-sonnet-5-5": {
          "inputUsdPerMTok": 2,
          "outputUsdPerMTok": 10,
          "cacheReadUsdPerMTok": 0.1,
          "cacheWriteUsdPerMTok": 2.5
        },
        "claude-haiku-5-5": {
          "inputUsdPerMTok": 0.1,
          "outputUsdPerMTok": 0.5,
          "cacheReadUsdPerMTok": 0.01,
          "cacheWriteUsdPerMTok": 0.125
        }
      },
      "notes": "Opus 5.5 and Sonnet 5.5 reject forced tool_choice; Opus 5.5 thinking cannot be disabled (use effort)."
    }
  ],
  "roles": {
    "planner": [
      {
        "provider": "pollinations",
        "model": "openai",
        "contextWindow": 32000,
        "supportsTools": true,
        "unverified": true
      },
      {
        "provider": "llm7",
        "model": "gpt-oss-120b",
        "contextWindow": 32000,
        "supportsTools": true,
        "unverified": true
      },
      {
        "provider": "webllm",
        "model": "Hermes-3-Llama-3.1-8B-q4f16_1-MLC",
        "contextWindow": 4096,
        "supportsTools": true,
        "quirks": ["browser-only"],
        "unverified": true
      },
      {
        "provider": "ollama",
        "model": "gpt-oss:20b",
        "contextWindow": 32768,
        "supportsTools": true,
        "quirks": ["num-ctx-must-be-set"],
        "unverified": true
      },
      {
        "provider": "nvidia",
        "model": "moonshotai/kimi-k3",
        "contextWindow": 256000,
        "supportsTools": true,
        "quirks": ["echo-reasoning-content"],
        "unverified": true
      },
      {
        "provider": "nvidia",
        "model": "deepseek-ai/deepseek-v4-pro",
        "contextWindow": 128000,
        "supportsTools": true,
        "unverified": true
      },
      {
        "provider": "openrouter",
        "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
        "contextWindow": 128000,
        "supportsTools": true,
        "unverified": true
      },
      {
        "provider": "groq",
        "model": "openai/gpt-oss-120b",
        "contextWindow": 131072,
        "supportsTools": true,
        "quirks": ["free-tier-8k-tpm"]
      },
      {
        "provider": "anthropic",
        "model": "claude-opus-5-5",
        "contextWindow": 200000,
        "supportsTools": true,
        "quirks": ["no-forced-tool-choice", "thinking-always-on"],
        "unverified": true
      }
    ],
    "worker": [
